import nu.pattern.OpenCV;
import org.opencv.core.*;
import org.opencv.highgui.HighGui;
import org.opencv.imgproc.Imgproc;
import org.opencv.video.BackgroundSubtractorMOG2;
import org.opencv.video.Video;
import org.opencv.videoio.VideoCapture;

import java.util.ArrayList;
import java.util.List;

public class LogitechFallTracker {

    public static void main(String[] args) {
        // Load native OpenCV libraries
        OpenCV.loadLocally();

        // 0 is usually built-in webcam; try 1 or 2 for your USB Logitech camera
        VideoCapture cap = new VideoCapture(1);
        if (!cap.isOpened()) {
            System.out.println("Error: Could not open Logitech camera.");
            return;
        }

        BackgroundSubtractorMOG2 bgSubtractor = Video.createBackgroundSubtractorMOG2(500, 50, false);
        Mat frame = new Mat();
        Mat fgMask = new Mat();
        Mat kernel = new Mat();

        Integer prevY = null;
        boolean wasTall = false;

        while (cap.read(frame)) {
            if (frame.empty()) break;

            // 1. Detect motion mask and clean up noise
            bgSubtractor.apply(frame, fgMask);
            Imgproc.erode(fgMask, fgMask, kernel, new Point(-1, -1), 2);
            Imgproc.dilate(fgMask, fgMask, kernel, new Point(-1, -1), 2);

            // 2. Find contours of moving objects
            List<MatOfPoint> contours = new ArrayList<>();
            Mat hierarchy = new Mat();
            Imgproc.findContours(fgMask, contours, hierarchy, Imgproc.RETR_EXTERNAL, Imgproc.CHAIN_APPROX_SIMPLE);

            for (MatOfPoint contour : contours) {
                // Ignore small noise (tune 2000 based on object size/distance)
                if (Imgproc.contourArea(contour) < 2000) continue;

                Rect rect = Imgproc.boundingRect(contour);
                int centerY = rect.y + (rect.height / 2);
                double aspectRatio = (double) rect.width / rect.height;

                Scalar color = new Scalar(0, 255, 0); // Green = normal
                String status = "Tracking";

                // 3. Check if object was previously upright (taller than wide)
                if (aspectRatio < 0.7) {
                    wasTall = true;
                }

                // 4. Detect fall: was upright, is now wide, and moved downward
                if (wasTall && aspectRatio > 1.3 && prevY != null && centerY > prevY + 10) {
                    color = new Scalar(0, 0, 255); // Red = fell over
                    status = "FALL DETECTED!";
                    System.out.println("Alert: Object fell over!");
                    wasTall = false; // Reset after trigger
                }

                prevY = centerY;

                // Draw bounding box and label
                Imgproc.rectangle(frame, rect, color, 2);
                Imgproc.putText(frame, status, new Point(rect.x, rect.y - 10),
                        Imgproc.FONT_HERSHEY_SIMPLEX, 0.7, color, 2);
            }

            HighGui.imshow("Logitech Fall Tracker (Java)", frame);

            // Press 'q' or ESC to quit
            int key = HighGui.waitKey(1);
            if (key == 'q' || key == 27) {
                break;
            }
        }

        cap.release();
        HighGui.destroyAllWindows();
    }
}
